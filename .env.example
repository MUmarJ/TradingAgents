# Data vendor API keys

# Polygon.io - Free tier at https://polygon.io/ (now massive.com)
# Free tier: 5 API calls/min, no daily cap, 2 years history, OHLCV + news + SMA/EMA/RSI/MACD
# Paid ($199+/mo): Unlimited calls, real-time data, financials
POLYGON_API_KEY=polygon_api_key_placeholder

# Alpha Vantage - Free tier at https://www.alphavantage.co/
# Free tier: 5 calls/min, 500 calls/day, fundamentals + news + indicators
ALPHA_VANTAGE_API_KEY=alpha_vantage_api_key_placeholder

# Social Sentiment API keys (optional - enables additional data sources)

# StockGeist - NLP sentiment from social media & news for 2,200+ US stocks
# Free tier: 10,000 credits/month. Sign up at https://www.stockgeist.ai/
# STOCKGEIST_API_KEY=stockgeist_api_key_placeholder

# Finnhub - Free tier at https://finnhub.io/ (NOTE: Social Sentiment requires PREMIUM subscription)
# Free tier works for: news, quotes, financials, insider transactions
# Premium required for: social sentiment (Reddit/Twitter) - ~$50/month
FINNHUB_API_KEY=finnhub_api_key_placeholder

# Reddit PRAW - Create app at https://www.reddit.com/prefs/apps
# Select "script" type, use http://localhost:8080 as redirect URI
REDDIT_CLIENT_ID=reddit_client_id_placeholder
REDDIT_CLIENT_SECRET=reddit_client_secret_placeholder

# Note: Stocktwits doesn't require an API key (default sentiment source)

# Data Source Configuration (change vendors per category)
# Each category can use a different data vendor. Automatic fallback if primary fails.
# DATA_VENDOR_STOCK=polygon             # Options: polygon (default), yfinance, alpha_vantage, local
# DATA_VENDOR_INDICATORS=polygon        # Options: polygon (default, unsupported fallback to yfinance), yfinance, alpha_vantage, local
# DATA_VENDOR_FUNDAMENTALS=alpha_vantage  # Options: alpha_vantage (default), yfinance, openai, local (polygon requires $199/mo)
# DATA_VENDOR_NEWS=polygon,alpha_vantage  # (default) Dual-source with deduplication; Options: polygon, alpha_vantage, openai, google, local

# Social Sentiment Vendor Selection
# Controls which data source the Social Media Analyst uses
# SOCIAL_SENTIMENT_VENDOR=stocktwits    # (default) Free, no API key - dedicated stock social platform
# SOCIAL_SENTIMENT_VENDOR=stockgeist    # Free tier (10k credits/mo) - NLP sentiment from social media & news
# SOCIAL_SENTIMENT_VENDOR=finnhub       # Requires FINNHUB_API_KEY (premium) - Reddit + Twitter sentiment
# SOCIAL_SENTIMENT_VENDOR=aggregated    # Combines available sources (Stocktwits, Finnhub, Reddit PRAW)
# Note: ApeWisdom has been disabled as a source (unreliable data quality)

# LLM Provider API keys (set the ones you want to use)
OPENAI_API_KEY=openai_api_key_placeholder
ANTHROPIC_API_KEY=anthropic_api_key_placeholder
GEMINI_API_KEY=gemini_api_key_placeholder
OPENROUTER_API_KEY=openrouter_api_key_placeholder

# LLM Model Configuration
# LLM_PROVIDER=openai                           # Options: openai, anthropic, google, ollama, openrouter, lm studio
# DEEP_THINK_LLM=gpt-4o                         # Model for complex reasoning (debates, final decisions)
# QUICK_THINK_LLM=gpt-4o-mini                   # Model for quick tasks (analysts, tools)
# LLM_BACKEND_URL=https://api.openai.com/v1    # API endpoint (change for local/custom providers)

# Local LLM provider URLs (optional, defaults shown)
# OLLAMA_URL=http://localhost:11434
# LM_STUDIO_URL=http://localhost:1234

# Feature Toggles
FETCH_LATEST=true                              # Fetch latest models from APIs
MEMORY_ENABLED=true                            # ChromaDB embedding-based memory for researchers
ACE_ENABLED=false                              # Agentic Context Engineering (self-improving agents)
# ACE_SKILLBOOK=./results/ace_skillbook.json   # Path to ACE skillbook file

# News article limits (per recall period)
# These control how many articles are fetched for each lookback period
# NEWS_LIMIT_DEFAULT=50       # Default (7 days)
# NEWS_LIMIT_3MO=200          # 3 month recall
# NEWS_LIMIT_6MO=500          # 6 month recall
# NEWS_LIMIT_12MO=500         # 12 month recall (capped to avoid context overflow)

# Social sentiment message limits (per recall period)
# These mirror news limits for balanced analysis between news and sentiment
# Stocktwits rate limit: 200 requests/hour, 30 msgs/request = 6000 msgs/hour capacity
# SENTIMENT_LIMIT_DEFAULT=50  # Default (7 days) - 2 pages
# SENTIMENT_LIMIT_3MO=200     # 3 month recall - 7 pages
# SENTIMENT_LIMIT_6MO=500     # 6 month recall - 17 pages
# SENTIMENT_LIMIT_12MO=500    # 12 month recall (max ~600 practical limit)

# News monthly bucketing (for long recall periods)
# When enabled, fetches articles from each month separately for true temporal diversity
# This ensures a 12-month recall actually covers all 12 months, not just recent articles
NEWS_MONTHLY_BUCKETING=false  # Set to true to enable monthly fetching

# News company name fallback (for obscure/small-cap tickers)
# When enabled, retries with company name if ticker search returns few/no results
# Useful for tickers like RAPT that may be indexed under "RAPT Therapeutics" instead
# NEWS_COMPANY_FALLBACK=true  # Enabled by default, set to false to disable